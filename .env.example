# Example values for docker compose. Copy to .env: cp .env.example .env
# Replace the token before you start the stack. The API rejects the placeholder.
# Create one with: openssl rand -hex 32
PULSE_PROBE_TOKEN=replace-with-a-random-token
PULSE_LOCATION=default
# Host ports. Uncomment to change them.
# PULSE_API_PORT=3000
# PULSE_STATUS_PORT=8080
# PULSE_CONSOLE_PORT=8082
