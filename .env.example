# Example values for docker compose. Copy to .env: cp .env.example .env
# The token below is public. Replace it before you expose the stack: openssl rand -hex 32
PULSE_PROBE_TOKEN=example-token-change-me-0000
PULSE_LOCATION=default
# Host ports. Uncomment to change them.
# PULSE_API_PORT=3000
# PULSE_STATUS_PORT=8080
