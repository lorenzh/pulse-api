{
  "checks": [
    {
      "id": "status-page",
      "name": "Status page",
      "url": "http://status:8080/",
      "intervalMs": 10000,
      "timeoutMs": 2000
    },
    {
      "id": "tcp-status",
      "name": "Status page port",
      "type": "tcp",
      "host": "status",
      "port": 8080,
      "intervalMs": 10000,
      "timeoutMs": 2000
    },
    {
      "id": "dns-api",
      "name": "DNS api",
      "type": "dns",
      "dnsName": "api",
      "recordType": "A",
      "intervalMs": 10000,
      "timeoutMs": 2000
    }
  ]
}
