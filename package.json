{
  "name": "@lorenzh/pulse-api",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Receives probe results, stores them (SQLite later), computes up/down state and incidents, and serves REST.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"**/test/**\" --test-coverage-exclude=\"dist/**\"",
    "lint": "biome check . && eslint --config tools/sonarjs/eslint.config.js .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "lefthook": "2.2.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#78c86dcc3761dabcd57988da81b3270c75df12f0"
  },
  "workspaces": [
    "tools/sonarjs"
  ],
  "overrides": {
    "ts-api-utils": {
      "typescript": "6.0.3"
    }
  }
}
